compatibility_level = 3.8
myhostname = mx.inboxpipe.net
mydomain = inboxpipe.net
myorigin = $myhostname
mydestination =
inet_interfaces = all
inet_protocols = all
# Trust only loopback and the web container's fixed address, never the whole
# Docker subnet. Other containers and public clients cannot relay.
mynetworks = 127.0.0.0/8, [::1]/128, 172.30.0.10/32
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
readme_directory = no
recipient_delimiter =

relay_domains = in.inboxpipe.net, proxy:pgsql:/etc/postfix/relay-domains.cf
relay_recipient_maps = proxy:pgsql:/etc/postfix/recipient-map.cf
transport_maps = proxy:pgsql:/etc/postfix/transport.cf, hash:/etc/postfix/transport
sender_canonical_classes = envelope_sender
sender_canonical_maps = hash:/etc/postfix/sender-canonical
mailsocket_destination_recipient_limit = 1

smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, permit_mynetworks, reject_unauth_destination
smtpd_reject_unlisted_recipient = yes
unknown_relay_recipient_reject_code = 550
show_user_unknown_table_name = no
strict_rfc821_envelopes = yes
disable_vrfy_command = yes

message_size_limit = 10485760
mailbox_size_limit = 0
maximal_queue_lifetime = 5d
bounce_queue_lifetime = 5d

# entrypoint (tls-setup.sh) switches to `may` + smtpd_tls_chain_files ONLY when
# /etc/postfix/tls/{privkey,fullchain}.pem exist and are readable, so a missing
# cert never stops mail. Opportunistic only: never `encrypt` on a public MX.
smtpd_tls_security_level = none
smtpd_tls_protocols = >=TLSv1.2
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_ciphers = high
smtpd_tls_mandatory_ciphers = high
# Mozilla "intermediate" TLS 1.2 suites (TLS 1.3 suites are OpenSSL defaults).
# Only smtpd uses grade `high`; the smtp client keeps the default `medium`.
tls_high_cipherlist = ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384:DHE-RSA-CHACHA20-POLY1305
tls_preempt_cipherlist = no
smtpd_tls_loglevel = 1
smtpd_tls_received_header = yes
smtpd_tls_session_cache_database = btree:${data_directory}/smtpd_scache
smtp_tls_security_level = may
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1

smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = inet:127.0.0.1:8891
milter_default_action = tempfail
milter_protocol = 6

maillog_file = /dev/stdout
maillog_file_prefixes = /var, /dev/stdout
notify_classes = resource, software
