# it does not ask anyone to reformat old files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,mjs,cjs,json,yml,yaml,html,css}]
indent_style = space
indent_size = 2

# The n8n community node follows the n8n starter (prettier useTabs: true);
# its package.json / package-lock.json are written by npm with 4 spaces.
[sdks/n8n/**.{js,ts,mjs,json}]
indent_style = tab
indent_size = 4

[sdks/n8n/package{,-lock}.json]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
