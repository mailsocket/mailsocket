DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=dash.mailsocket.app,mailsocket.app,web,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://dash.mailsocket.app,https://mailsocket.app
PUBLIC_BASE_URL=https://dash.mailsocket.app
# apex = public site, dash = product; GET/HEAD on the wrong host 301 (operations notes "Hosts").
# Defaults to true in production settings; set false to switch redirects + absolute cross-host links off.
CANONICAL_HOST_REDIRECTS=true
DB_NAME=mailsocket
DB_USERNAME=mailsocket
DB_PASS=replace-with-a-strong-database-password
DB_HOST=db
DB_PORT=5432
INGEST_SHARED_SECRET=replace-with-a-long-random-shared-secret
AUTH_RATE_LIMIT_SECRET=replace-with-a-dedicated-long-random-auth-rate-limit-secret
API_KEY_PEPPER=replace-with-a-dedicated-long-random-api-key-pepper
WEBHOOK_SIGNING_MASTER_KEY=replace-with-a-dedicated-long-random-webhook-signing-key
INGEST_ALLOWED_CIDRS=172.30.0.250/32
MAIL_DOMAIN=in.inboxpipe.net
MAX_INBOUND_BYTES=10485760
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
POSTFIX_DB_READER_USER=mailsocket_postfix
POSTFIX_DB_READER_PASSWORD=replace-with-a-strong-read-only-password
POSTFIX_QUEUE_MAX_DAYS=5
POSTFIX_INGEST_SECRET_FILE=./secrets/ingest_shared_secret
POSTFIX_SIGNING_KEY_FILE=./secrets/dkim/ms1.private
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
OPS_ALERT_EMAIL=ops@mailsocket.app
# Ops alerts to Telegram too (bot). Both empty = Telegram
# channel off. The token is a SECRET (BotFather) — set it only in the server .env.
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_ID=
BACKUP_DIR=./backups
BACKUP_RETENTION_COUNT=14

# CSP form-action allows exactly this origin (LS hosted checkout + customer portal). Must be scheme://host only.
LS_CHECKOUT_ORIGIN=https://mailsocket.lemonsqueezy.com

# Billing reconciliation dead-man (manage.py billing_reconcile, daily cron): Healthchecks.io
# ping URL, pinged after every completed run. Empty = no ping (the run logs "skipped").
HEALTHCHECKS_RECONCILE_URL=

# Billing kill switch (operations notes): false/0 pauses checkout and plan
# changes (webhooks + customer portal keep working). Exactly true/false/1/0, else
# the container refuses to start (mailsocket.E008). Unset = true.
BILLING_CHANGES_ENABLED=true
